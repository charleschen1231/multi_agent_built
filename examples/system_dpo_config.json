[
  {
    "agent_id": "planner",
    "model": {
      "name_or_path": "Qwen/Qwen2.5-0.5B-Instruct"
    },
    "instruction_prompt": {
      "instruction": "你是 Planner Agent：负责将用户的数学问题拆解为清晰的解题步骤计划。请输出结构化的解题计划。",
      "prompt_template": "用户的数学问题：{{input.user_request}}\n\n请输出你的解题计划（分步骤列出）："
    },
    "input": [
      { "from": "user", "key": "user_request" }
    ],
    "output": [
      { "key": "plan", "to": [ { "agent": "infer", "as": "plan" } ] }
    ],
    "training": {
      "mode": "dpo",
      "trainable": true,
      "ground_truth": {
        "gt_key": "plan_gt"
      },
      "loss": {
        "type": "dpo",
        "weight": 1.0
      },
      "train_parameters": {
        "lr": 5e-7,
        "beta": 0.1,
        "num_epochs": 3,
        "batch_size": 2
      }
    }
  },
  {
    "agent_id": "infer",
    "model": {
      "name_or_path": "Qwen/Qwen2.5-0.5B-Instruct"
    },
    "instruction_prompt": {
      "instruction": "你是 Inference Agent：根据 Planner 提供的解题计划，对用户的数学问题进行详细计算，得出答案。",
      "prompt_template": "解题计划：{{input.plan}}\n\n用户的数学问题：{{input.user_request}}\n\n请按照计划逐步计算并给出答案："
    },
    "input": [
      { "from": "user", "key": "user_request" },
      { "from": "planner", "key": "plan" }
    ],
    "output": [
      { "key": "draft_answer", "to": [ { "agent": "checker", "as": "draft_answer" } ] }
    ],
    "training": {
      "mode": "dpo",
      "trainable": true,
      "ground_truth": {
        "gt_key": "draft_answer_gt"
      },
      "loss": {
        "type": "dpo",
        "weight": 1.0
      },
      "train_parameters": {
        "lr": 5e-7,
        "beta": 0.1,
        "num_epochs": 3,
        "batch_size": 2
      }
    }
  },
  {
    "agent_id": "checker",
    "model": {
      "name_or_path": "Qwen/Qwen2.5-0.5B-Instruct"
    },
    "instruction_prompt": {
      "instruction": "你是 Checker Agent：检查计算过程和答案是否正确，验证无误后给出最终答案。如果发现问题请指出并修正。",
      "prompt_template": "用户的数学问题：{{input.user_request}}\n候选答案：{{input.draft_answer}}\n\n请检查答案是否正确，并给出最终结果："
    },
    "input": [
      { "from": "user", "key": "user_request" },
      { "from": "infer", "key": "draft_answer" }
    ],
    "output": [
      { "key": "final_answer", "to": [ { "user": true } ] },
      { "key": "verdict", "to": [ { "user": true } ] }
    ],
    "training": {
      "mode": "dpo",
      "trainable": true,
      "ground_truth": {
        "gt_key": "final_answer_gt"
      },
      "loss": {
        "type": "dpo",
        "weight": 1.0
      },
      "train_parameters": {
        "lr": 5e-7,
        "beta": 0.1,
        "num_epochs": 3,
        "batch_size": 2
      }
    }
  }
]

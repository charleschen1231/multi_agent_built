{
  "name": "system_dpo_test",
  "description": "System-level DPO training for 3-agent pipeline (planner -> infer -> checker)",
  "version": "1.0",
  
  "agents": [
    {
      "agent_id": "planner",
      "name": "PlanAgent",
      "description": "制定解题计划",
      "model": {
        "name_or_path": "/root/autodl-tmp/models/Qwen2.5-0.5B-Instruct",
        "api_key": "",
        "base_url": ""
      },
      "instruction_prompt": {
        "instruction": "你是一个专业的解题规划师。请为用户问题制定清晰的解题步骤。",
        "prompt_template": "问题：{{input.user_request}}\n\n请制定解题计划："
      },
      "input": [
        {"key": "user_request", "from": "user"}
      ],
      "output": [
        {"key": "plan", "to": [{"agent": "infer", "as": "plan"}]}
      ],
      "training": {
        "trainable": true,
        "mode": "dpo",
        "dataset": {
          "input_key": "user_request"
        },
        "ground_truth": {
          "output_key": "plan",
          "gt_key": "plan_gt"
        },
        "loss": {
          "type": "dpo",
          "weight": 1.0
        }
      }
    },
    {
      "agent_id": "infer",
      "name": "InferAgent",
      "description": "执行推理计算",
      "model": {
        "name_or_path": "/root/autodl-tmp/models/Qwen2.5-0.5B-Instruct",
        "api_key": "",
        "base_url": ""
      },
      "instruction_prompt": {
        "instruction": "你是一个数学推理专家。请根据计划逐步解答问题。",
        "prompt_template": "问题：{{input.user_request}}\n计划：{{input.plan_output}}\n\n请解答："
      },
      "input": [
        {"key": "user_request", "from": "user"},
        {"key": "plan_output", "from": "planner"}
      ],
      "output": [
        {"key": "draft_answer", "to": [{"agent": "checker", "as": "draft_answer"}]}
      ],
      "training": {
        "trainable": true,
        "mode": "dpo",
        "dataset": {
          "input_key": "user_request"
        },
        "ground_truth": {
          "output_key": "draft_answer",
          "gt_key": "draft_answer_gt"
        },
        "loss": {
          "type": "dpo",
          "weight": 1.0
        }
      }
    },
    {
      "agent_id": "checker",
      "name": "CheckerAgent",
      "description": "检查答案正确性",
      "model": {
        "name_or_path": "/root/autodl-tmp/models/Qwen2.5-0.5B-Instruct",
        "api_key": "",
        "base_url": ""
      },
      "instruction_prompt": {
        "instruction": "你是一个答案验证专家。请检查推理结果是否正确。",
        "prompt_template": "问题：{{input.user_request}}\n推理：{{input.infer_output}}\n\n请验证："
      },
      "input": [
        {"key": "user_request", "from": "user"},
        {"key": "infer_output", "from": "infer"}
      ],
      "output": [
        {"key": "final_answer", "to": [{"user": true}]},
        {"key": "verdict", "to": [{"user": true}]}
      ],
      "training": {
        "trainable": true,
        "mode": "dpo",
        "dataset": {
          "input_key": "user_request"
        },
        "ground_truth": {
          "output_key": "final_answer",
          "gt_key": "final_answer_gt"
        },
        "loss": {
          "type": "dpo",
          "weight": 1.0
        }
      }
    }
  ],
  
  "training_config": {
    "output_dir": "./training_outputs/dpo",
    "num_train_epochs": 3,
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "learning_rate": 5e-6,
    "warmup_ratio": 0.1,
    "logging_steps": 10,
    "save_steps": 100,
    "evaluation_strategy": "no",
    "report_to": ["tensorboard"],
    
    "swift_params": {
      "model_type": "qwen2",
      "dataset": "./data/dpo_dataset.jsonl",
      "dataset_val_ratio": 0.1,
      "max_length": 512,
      "beta": 0.1,
      "loss_type": "sigmoid"
    }
  }
}
